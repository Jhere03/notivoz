  "cards": [
    { "dot": "violet", "title": "Pedido por voz", "items": [
      "«Notivoz» muestra la burbuja; al presionarla (o tu tecla) te escucha",
      "Al callarte, Whisper transcribe en tu PC: el audio no sale del equipo",
      "Solo el texto va a Claude; la respuesta se dice y se lee en la nube",
      "Comandos exactos («Notivoz, modo relax») se ejecutan sin IA"
    ] },
    { "dot": "rose", "title": "Seguridad", "items": [
      "La clave de la IA va cifrada en el Administrador de credenciales, nunca en el .exe",
      "Solo se conecta a api.anthropic.com; límite de 1 USD al mes",
      "La IA solo usa una lista cerrada de acciones, validadas antes de ejecutarse",
      "Eliminar o apagar la PC solo si tú lo pides; «ahora» pide tu «sí»"
    ] },
    { "dot": "emerald", "title": "También", "items": [
      "Chateemos usa el mismo Asistente IA por escrito",
      "Programadores: avisan en voz alta y abren la alerta encima de todo",
      "Modelos de Vosk y Whisper se descargan una vez y se verifican con SHA-256",
      "Todo se guarda en tu PC: SQLite en %APPDATA%\\Notivoz"
    ] }
  ]
